[
  {"prompt": "How many open cases are in the queue?", "must": ["/queue/open"], "may": []},
  {"prompt": "What is the average wait time?", "must": ["/queue/avgWaitSeconds"], "may": []},
  {"prompt": "How many cases are pending?", "must": ["/queue/pending"], "may": []},
  {"prompt": "How long has the oldest case been waiting?", "must": ["/queue/oldestWaitingMinutes"], "may": []},
  {"prompt": "Tell me the CSAT score", "must": ["/today/csat"], "may": []},
  {"prompt": "How many cases did I resolve today?", "must": ["/today/resolved"], "may": []},
  {"prompt": "What is the resolution rate?", "must": ["/today/resolutionRatePct"], "may": []},
  {"prompt": "How many cases were reopened today?", "must": ["/today/reopened"], "may": []},
  {"prompt": "What is my role?", "must": ["/agent/role"], "may": []},
  {"prompt": "Show my email address", "must": ["/agent/email"], "may": []},
  {"prompt": "List all the cases", "must": ["/cases"], "may": []},
  {"prompt": "Show Medium priority cases", "must": ["/cases"], "may": [], "filter": {"field": "priority", "equals": "Medium"}},
  {"prompt": "Show cases from Gold customers", "must": ["/cases"], "may": [], "filter": {"field": "customer.tier", "equals": "Gold"}},
  {"prompt": "Which cases are waiting on customer?", "must": ["/cases"], "may": [], "filter": {"field": "status", "equals": "Waiting on Customer"}},
  {"prompt": "Show cases that came in by phone", "must": ["/cases"], "may": [], "filter": {"field": "channel", "equals": "Phone"}},
  {"prompt": "Show the 5 newest cases", "must": ["/cases"], "may": [], "limit": 5, "sort_any": [["openedAt", "desc"], ["ageHours", "asc"]]},
  {"prompt": "Top 2 oldest cases", "must": ["/cases"], "may": [], "limit": 2, "sort_any": [["ageHours", "desc"], ["openedAt", "asc"]]},
  {"prompt": "Table of cases with id, subject and priority", "must": ["/cases"], "may": [], "type": "table", "fields_include": ["id", "subject", "priority"]},
  {"prompt": "Which team members are available?", "must": ["/team"], "may": [], "filter": {"field": "status", "equals": "Available"}},
  {"prompt": "Team members with the highest weekly CSAT", "must": ["/team"], "may": [], "sort_any": [["csatWeek", "desc"]]},
  {"prompt": "Show the last 2 activity updates", "must": ["/recentActivity"], "may": [], "limit": 2, "sort_any": [["at", "desc"]]},
  {"prompt": "Recent status changes", "must": ["/recentActivity"], "may": [], "filter": {"field": "type", "equals": "Status change"}},
  {"prompt": "Notes on cases", "must": ["/recentActivity"], "may": [], "filter": {"field": "type", "equals": "Note"}},
  {"prompt": "Compare my CSAT with the team", "must": ["/today/csat", "/team"], "may": []},
  {"prompt": "How are we doing?", "vague": true, "must": ["/queue/open"], "may": ["/queue/pending", "/queue/avgWaitSeconds", "/queue/slaBreaches", "/today/resolved", "/today/csat"]},
  {"prompt": "Give me an overview", "vague": true, "must": ["/queue/open"], "may": ["/queue/pending", "/queue/avgWaitSeconds", "/queue/slaBreaches", "/today/resolved", "/today/csat"]},
  {"prompt": "What should I focus on?", "vague": true, "must": ["/queue/slaBreaches"], "may": ["/queue/open", "/cases", "/queue/oldestWaitingMinutes"]},
  {"prompt": "What's the weather like?", "vague": true, "must": ["/queue/open"], "may": []}
]
