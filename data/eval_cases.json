[
  {"prompt": "How many cases are in the queue and what's the average wait?",
   "must": ["/queue/open", "/queue/avgWaitSeconds"], "may": ["/queue/pending"]},
  {"prompt": "Show me the high priority cases",
   "must": ["/cases"], "may": [], "filter": {"field": "priority", "equals": "High"}},
  {"prompt": "What's my CSAT today?",
   "must": ["/today/csat"], "may": []},
  {"prompt": "Who is on the team and how many open cases does each person have?",
   "must": ["/team"], "may": [], "fields_include": ["openCases"]},
  {"prompt": "Any SLA breaches?",
   "must": ["/queue/slaBreaches"], "may": []},
  {"prompt": "Show escalated cases as a table with customer name and priority",
   "must": ["/cases"], "may": [], "type": "table", "filter": {"field": "status", "equals": "Escalated"}, "fields_include": ["customer.name", "priority"]},
  {"prompt": "Summarize my day",
   "must": ["/today/resolved", "/today/csat"], "may": ["/today/firstResponseMinutes", "/today/resolutionRatePct", "/today/reopened", "/queue/open", "/queue/slaBreaches"]},
  {"prompt": "What is my current status?",
   "must": ["/agent/status"], "may": []},
  {"prompt": "Latest 3 activity updates",
   "must": ["/recentActivity"], "may": [], "limit": 3, "sort_any": [["at", "desc"]]},
  {"prompt": "Show the 3 oldest cases",
   "must": ["/cases"], "may": [], "limit": 3, "sort_any": [["ageHours", "desc"], ["openedAt", "asc"]]},
  {"prompt": "Which Platinum customers do we have open cases for?",
   "must": ["/cases"], "may": [], "filter": {"field": "customer.tier", "equals": "Platinum"}},
  {"prompt": "How long until first response on average?",
   "must": ["/today/firstResponseMinutes"], "may": []}
]
